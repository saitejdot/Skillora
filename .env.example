# Database configuration (PostgreSQL: Neon, Supabase, or local PostgreSQL)
# For Neon: DATABASE_URL is the pooled connection string (with -pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
# For Neon migrations: unpooled connection string (without -pooler)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth configuration
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-nextauth-secret"
# On Vercel, NEXTAUTH_URL is automatically inferred if omitted, or set to your custom domain
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary image storage (optional for demo, default placeholders provided)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="skillora_preset"
